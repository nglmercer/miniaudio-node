{
  "name": "miniaudio_node",
  "version": "1.6.3",
  "description": "High-performance native audio playback for Node.js and Bun. Built with Rust and the powerful rodio audio engine.",
  "keywords": [
    "audio",
    "sound",
    "music",
    "playback",
    "rust",
    "native",
    "miniaudio",
    "rodio",
    "nodejs",
    "bun",
    "wav",
    "mp3",
    "flac",
    "ogg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nglmercer/miniaudio-node.git"
  },
  "homepage": "https://github.com/nglmercer/miniaudio-node#readme",
  "bugs": {
    "url": "https://github.com/nglmercer/miniaudio-node/issues"
  },
  "scripts": {
    "build": "napi build --platform --release --js index.cjs --dts index.d.ts && napi build --platform --release --esm --js index.mjs --dts index.d.mts",
    "build:debug": "napi build --platform --js index.cjs --dts index.d.ts && napi build --platform --esm --js index.mjs --dts index.d.mts",
    "build:watch": "napi build --watch --platform --js index.cjs --dts index.d.ts",
    "test": "bun test",
    "test:deterministic": "bun test tests/unit/deterministic.test.ts",
    "test:hardware": "bun test tests/hardware/audio-paths.test.ts tests/unit/audio-player.test.ts tests/integration/playback.test.ts",
    "tsc": "tsc",
    "lint": "cargo fmt --all -- --check && cargo clippy --all-targets --all-features -- -D warnings",
    "format": "cargo fmt --all",
    "clean": "napi clean && cargo clean",
    "copy:artifacts": "bun ./scripts/copy-artifacts.js",
    "examples:simple": "bun ./examples/simple-playback.ts",
    "examples:controls": "bun ./examples/playback-controls.ts",
    "examples:buffer": "bun ./examples/buffer-loading.ts",
    "examples:device": "bun ./examples/device-management.ts",
    "examples:playlist": "bun ./examples/playlist.ts"
  },
  "main": "index.cjs",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.cjs",
    "index.mjs",
    "index.d.ts",
    "index.d.mts",
    "*.node",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@napi-rs/cli": "^3.8.6",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "napi": {
    "binaryName": "miniaudio_node",
    "targets": [
      "x86_64-pc-windows-msvc",
      "i686-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "author": {
    "name": "nglmercer",
    "email": "nglmercer@gmail.com"
  }
}
